// ============================================================================
// HTTP-сервис: DemoApi (корневой URL: demo-api)
// Шаблон URL: reo_statement   Метод: GET   Обработчик: reo_statementGET
// Версия: v2.0 (отбор по договорам с ИнвестСтрой, полнота проводок)
//
// ПРИНЦИП ОТБОРА (v2.0): проводка релевантна, если выбранный договор с ИнвестСтрой
// стоит в СубконтоДт2 ИЛИ СубконтоКт2. Отбор по счетам убран - ловим ВСЕ
// проводки по нашим договорам, включая нестандартные (возвраты авансов и
// т.п.), которые классифицируются как refund/other + needs_review.
// НГ (бит_стр_Строительство) - вспомогательный признак: выводится в записи,
// параметр ng - дополнительный фильтр.
//
// Параметры:
//   date_from, date_to - обязательные, ГГГГ-ММ-ДД (date_to включительно)
//   contracts    - список подстрок названий договоров через ";" (основной отбор)
//   counterparty - подстрока наименования контрагента (уточняет отбор)
//   ng           - опциональный доп. фильтр по номенклатурной группе
//
// Классификация:
//   Кт 62.0x: Дт 51/52 -> payment (advance/works); Дт 62.0x -> closed_advance;
//             Дт 90 -> realization (сторно, минус); Дт прочее -> cession
//   Дт 62.0x: Кт 51/52 -> refund (advance/works); Кт 90.01 -> realization;
//             Кт 62.0x -> closed_advance; Кт прочее -> other (needs_review)
// ============================================================================

Функция reo_statementGET(Запрос)

    // --- 1. Параметры и валидация -------------------------------------------
    СтрНачало      = Запрос.ПараметрыЗапроса.Получить("date_from");
    СтрОкончание   = Запрос.ПараметрыЗапроса.Получить("date_to");
    СтрКонтрагент  = Запрос.ПараметрыЗапроса.Получить("counterparty");
    СтрДоговоры    = Запрос.ПараметрыЗапроса.Получить("contracts");
    СтрИНН         = Запрос.ПараметрыЗапроса.Получить("inn");
    ФильтрНГ       = Запрос.ПараметрыЗапроса.Получить("ng");

    Если НЕ ЗначениеЗаполнено(СтрНачало) ИЛИ НЕ ЗначениеЗаполнено(СтрОкончание) Тогда
        Возврат СформироватьОтвет(400, "Не переданы параметры date_from и date_to");
    КонецЕсли;

    ДатаНачала    = РазобратьДатуISO(СтрНачало);
    ДатаОкончания = РазобратьДатуISO(СтрОкончание);
    Если ДатаНачала = Неопределено ИЛИ ДатаОкончания = Неопределено Тогда
        Возврат СформироватьОтвет(400, "Неверный формат даты. Используйте формат ГГГГ-ММ-ДД");
    КонецЕсли;

    Если ДатаОкончания < ДатаНачала Тогда
        Возврат СформироватьОтвет(400, "date_to меньше date_from");
    КонецЕсли;

    // Ограничение на длину периода убрано (v2.1): легитимны длинные периоды
    // (сверка за 2024-2026, первичное наполнение истории). Объём выборки
    // контролируется списком договоров, а не длиной периода.

    Если НЕ ЗначениеЗаполнено(СтрДоговоры) И НЕ ЗначениеЗаполнено(СтрКонтрагент) Тогда
        Возврат СформироватьОтвет(400,
            "Укажите параметр contracts (список договоров через ;) и/или counterparty");
    КонецЕсли;

    // --- 2. Список наших договоров ------------------------------------------
    // Резолвим по стандартным реквизитам (Наименование, Владелец) - быстро,
    // без обращения к объектам. Фильтрация по подстрокам - в коде (ВРег),
    // чтобы не зависеть от регистра ПОДОБНО на разных СУБД.
    ТекстЗапросаДоговоры =
    "ВЫБРАТЬ
    |    Договоры.Ссылка КАК Ссылка,
    |    Договоры.Наименование КАК Договор,
    |    Договоры.Владелец.НаименованиеПолное КАК Контрагент,
    |    Договоры.Владелец.ИНН КАК ИНН
    |ИЗ
    |    Справочник.ДоговорыКонтрагентов КАК Договоры
    |ГДЕ
    |    НЕ Договоры.ПометкаУдаления
    |    И НЕ Договоры.ЭтоГруппа";

    Попытка
        ЗапросДоговоры = Новый Запрос;
        ЗапросДоговоры.Текст = ТекстЗапросаДоговоры;
        ВыборкаДоговоры = ЗапросДоговоры.Выполнить().Выбрать();
    Исключение
        ОписаниеОшибкиПодробно = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
        Возврат СформироватьОтвет(500, "Ошибка запроса справочника договоров: " + ОписаниеОшибкиПодробно);
    КонецПопытки;

    ШаблоныДоговоров = Новый Массив;
    Если ЗначениеЗаполнено(СтрДоговоры) Тогда
        Части = СтрРазделить(СтрДоговоры, ";");
        Для Каждого Часть Из Части Цикл
            Часть = СокрЛП(Часть);
            Если ЗначениеЗаполнено(Часть) Тогда
                ШаблоныДоговоров.Добавить(ВРег(Часть));
            КонецЕсли;
        КонецЦикла;
    КонецЕсли;

    НашиДоговоры = Новый Соответствие;   // Ссылка -> Истина
    Кандидаты    = Новый Соответствие;   // ИНН -> Структура(Контрагент, ИНН, Договоров)
    Пока ВыборкаДоговоры.Следующий() Цикл
        Подходит = Истина;
        Если ШаблоныДоговоров.Количество() > 0 Тогда
            Подходит = Ложь;
            ИмяВР = ВРег(ВыборкаДоговоры.Договор);
            Для Каждого Шаблон Из ШаблоныДоговоров Цикл
                Если СтрНайти(ИмяВР, Шаблон) > 0 Тогда
                    Подходит = Истина;
                    Прервать;
                КонецЕсли;
            КонецЦикла;
        КонецЕсли;
        Если Подходит И ЗначениеЗаполнено(СтрКонтрагент) Тогда
            Подходит = ПодходитПодФильтр(ВыборкаДоговоры.Контрагент, СтрКонтрагент);
        КонецЕсли;
        Если Подходит И ЗначениеЗаполнено(СтрИНН) Тогда
            Подходит = ПодходитПодФильтр(ВыборкаДоговоры.ИНН, СтрИНН);
        КонецЕсли;
        Если НЕ Подходит Тогда
            Продолжить;
        КонецЕсли;

        НашиДоговоры.Вставить(ВыборкаДоговоры.Ссылка, Истина);

        // Кандидаты-контрагенты (для проверки неоднозначности по ИНН):
        // в базе бывают контрагенты с 100% одинаковыми именами - различаем по ИНН
        ИННКлюч = ВРег(СокрЛП(Строка(ВыборкаДоговоры.ИНН)));
        Кандидат = Кандидаты[ИННКлюч];
        Если Кандидат = Неопределено Тогда
            Кандидат = Новый Структура("Контрагент, ИНН, Договоров",
                Строка(ВыборкаДоговоры.Контрагент),
                Строка(ВыборкаДоговоры.ИНН),
                0);
            Кандидаты.Вставить(ИННКлюч, Кандидат);
        КонецЕсли;
        Кандидат.Договоров = Кандидат.Договоров + 1;
    КонецЦикла;

    Если НашиДоговоры.Количество() = 0 Тогда
        Возврат СформироватьОтвет(400,
            "Не найдено ни одного договора по заданным contracts/counterparty/inn");
    КонецЕсли;

    // Неоднозначность: под подходящим именем несколько РАЗНЫХ контрагентов
    // (разные ИНН), а ИНН для уточнения не передан -> возвращаем список
    // кандидатов (409), пользователь повторяет запрос с inn=...
    Если Кандидаты.Количество() > 1 И НЕ ЗначениеЗаполнено(СтрИНН) Тогда
        СписокКандидатов = Новый Массив;
        Для Каждого Пара Из Кандидаты Цикл
            СписокКандидатов.Добавить(Новый Структура("Контрагент, ИНН, Договоров",
                Пара.Значение.Контрагент,
                Пара.Значение.ИНН,
                Пара.Значение.Договоров));
        КонецЦикла;
        ОтветСтруктура = Новый Структура;
        ОтветСтруктура.Вставить("error", "ambiguous_counterparty");
        ОтветСтруктура.Вставить("message",
            "Найдено несколько контрагентов с подходящим именем - повторите запрос с параметром inn");
        ОтветСтруктура.Вставить("candidates", СписокКандидатов);
        ЗаписьJSON = Новый ЗаписьJSON;
        ЗаписьJSON.УстановитьСтроку();
        ЗаписатьJSON(ЗаписьJSON, ОтветСтруктура);
        Тело = ЗаписьJSON.Закрыть();
        Возврат СформироватьОтвет(409, Тело);
    КонецЕсли;

    // --- 3. Проводки по нашим договорам -------------------------------------
    // Виртуальная таблица ДвиженияССубконто; отбор по субконто2 (Договоры)
    // с ОБЕИХ сторон, без ограничений по счетам - полнота проводок.
    ТекстЗапроса =
    "ВЫБРАТЬ
    |    Движения.Период КАК Период,
    |    Движения.Регистратор.Номер КАК РегистраторНомер,
    |    Движения.Регистратор.Дата КАК РегистраторДата,
    |    Движения.СчетДт.Код КАК КодСчетаДт,
    |    Движения.СчетКт.Код КАК КодСчетаКт,
    |    ВЫРАЗИТЬ(Движения.СубконтоДт1 КАК Справочник.Контрагенты).НаименованиеПолное КАК КонтрагентДт,
    |    ВЫРАЗИТЬ(Движения.СубконтоДт1 КАК Справочник.Контрагенты).ИНН КАК ИННДт,
    |    Движения.СубконтоДт2 КАК ДоговорДт,
    |    Движения.СубконтоДт3 КАК ДокРасчДт,
    |    ВЫРАЗИТЬ(Движения.СубконтоКт1 КАК Справочник.Контрагенты).НаименованиеПолное КАК КонтрагентКт,
    |    ВЫРАЗИТЬ(Движения.СубконтоКт1 КАК Справочник.Контрагенты).ИНН КАК ИННКт,
    |    Движения.СубконтоКт2 КАК ДоговорКт,
    |    Движения.СубконтоКт3 КАК ДокРасчКт,
    |    Движения.Сумма КАК Сумма
    |ИЗ
    |    РегистрБухгалтерии.Хозрасчетный.ДвиженияССубконто(&ДатаНачала, &ДатаОкончанияКонец, , , ) КАК Движения
    |ГДЕ
    |    Движения.СубконтоДт2 В (&НашиДоговоры)
    |    ИЛИ Движения.СубконтоКт2 В (&НашиДоговоры)
    |УПОРЯДОЧИТЬ ПО
    |    Движения.Период";

    Попытка
        Запрос1С = Новый Запрос;
        Запрос1С.Текст = ТекстЗапроса;
        Запрос1С.УстановитьПараметр("ДатаНачала", ДатаНачала);
        Запрос1С.УстановитьПараметр("ДатаОкончанияКонец", КонецДня(ДатаОкончания));
        МассивСсылок = Новый Массив;
        Для Каждого Пара Из НашиДоговоры Цикл
            МассивСсылок.Добавить(Пара.Ключ);
        КонецЦикла;
        Запрос1С.УстановитьПараметр("НашиДоговоры", МассивСсылок);
        Выборка = Запрос1С.Выполнить().Выбрать();
    Исключение
        ОписаниеОшибкиПодробно = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
        Возврат СформироватьОтвет(500, "Ошибка выполнения запроса: " + ОписаниеОшибкиПодробно);
    КонецПопытки;

    // --- 4. Классификация и сборка записей ----------------------------------
    МассивДанных = Новый Массив;
    КэшДоговоров = Новый Соответствие;   // кэш реквизитов договоров (через объект)

    Пока Выборка.Следующий() Цикл

        КодДт = Строка(Выборка.КодСчетаДт);   // Строка сразу: защита от NULL
        КодКт = Строка(Выборка.КодСчетаКт);
        ЭтоДт62     = СтрНачинаетсяС(КодДт, "62.");
        ЭтоКт62     = СтрНачинаетсяС(КодКт, "62.");
        ЭтоДеньгиДт = СтрНачинаетсяС(КодДт, "51") ИЛИ СтрНачинаетсяС(КодДт, "52");
        ЭтоДеньгиКт = СтрНачинаетсяС(КодКт, "51") ИЛИ СтрНачинаетсяС(КодКт, "52");
        ЭтоДт90     = СтрНачинаетсяС(КодДт, "90.");
        ЭтоКт90     = СтрНачинаетсяС(КодКт, "90.");
        ЭтоДт91     = СтрНачинаетсяС(КодДт, "91.");

        // Наш договор на одной из сторон?
        НашНаДт = (НашиДоговоры[Выборка.ДоговорДт] <> Неопределено);
        НашНаКт = (НашиДоговоры[Выборка.ДоговорКт] <> Неопределено);
        Если НЕ НашНаДт И НЕ НашНаКт Тогда
            Продолжить;   // страховка: проводка не касается наших договоров
        КонецЕсли;

        // Классификация по корреспонденции
        Знак = 1;
        Если ЭтоКт62 И ЭтоДт62 Тогда
            RecordType  = "closed_advance";
            PaymentType = "";
        ИначеЕсли ЭтоКт62 Тогда
            Если ЭтоДеньгиДт Тогда
                RecordType  = "payment";
                PaymentType = ?(СтрНачинаетсяС(КодКт, "62.02"), "advance", "works");
            ИначеЕсли ЭтоДт90 Тогда
                RecordType  = "realization";
                PaymentType = "";
                Знак = -1;
            ИначеЕсли ЭтоДт91 Тогда
                // Дт 91.02 Кт 62.01 - корректировка дебиторки через прочие
                // расходы (не цессия, не влияет на колонки отчёта)
                RecordType  = "other";
                PaymentType = "";
            Иначе
                RecordType  = "payment";
                PaymentType = "cession";
            КонецЕсли;
        ИначеЕсли ЭтоДт62 Тогда
            Если ЭтоДеньгиКт Тогда
                RecordType  = "refund";
                PaymentType = ?(СтрНачинаетсяС(КодДт, "62.02"), "advance", "works");
            ИначеЕсли ЭтоКт90 Тогда
                RecordType  = "realization";
                PaymentType = "";
            ИначеЕсли ЭтоКт62 Тогда
                RecordType  = "closed_advance";
                PaymentType = "";
            Иначе
                RecordType  = "other";
                PaymentType = "";
            КонецЕсли;
        Иначе
            RecordType  = "other";
            PaymentType = "";
        КонецЕсли;
        СуммаПроводки = Выборка.Сумма;
        Если ТипЗнч(СуммаПроводки) <> Тип("Число") Тогда
            СуммаПроводки = 0;   // NULL/неожиданный тип - не роняем сервис
        КонецЕсли;
        Сумма = Знак * СуммаПроводки;

        // Сторона записи: предпочитаем Дт (если наш договор там)
        Если НашНаДт Тогда
            ДоговорRef   = Выборка.ДоговорДт;
            Контрагент   = Строка(Выборка.КонтрагентДт);
            ИНН          = Строка(Выборка.ИННДт);
            ДокументРасч = Строка(Выборка.ДокРасчДт);
        Иначе
            ДоговорRef   = Выборка.ДоговорКт;
            Контрагент   = Строка(Выборка.КонтрагентКт);
            ИНН          = Строка(Выборка.ИННКт);
            ДокументРасч = Строка(Выборка.ДокРасчКт);
        КонецЕсли;

        // Реквизиты договора через объект (видны и для расширений), с кэшем
        ДанныеДоговора = ПолучитьДанныеДоговора(ДоговорRef, КэшДоговоров);
        Договор     = ДанныеДоговора.Договор;
        ВидДоговора = ДанныеДоговора.ВидДоговора;
        НГ          = ДанныеДоговора.НГ;

        // --- 5. Опциональный фильтр по НГ (вспомогательный) ------------------
        Если НЕ ПодходитПодФильтр(НГ, ФильтрНГ) Тогда
            Продолжить;
        КонецЕсли;

        // --- 6. Пометки для приёмки ------------------------------------------
        // other - неизвестный паттерн; needs_review - пустая аналитика.
        // Такие записи НЕ отбрасываем - помечаем и отдаём как есть.
        NeedsReview = (Договор = "" ИЛИ Контрагент = "" ИЛИ RecordType = "other");

        Запись = Новый Структура;
        Запись.Вставить("record_type",           RecordType);
        Запись.Вставить("payment_type",          PaymentType);
        Запись.Вставить("СчетДт",                Строка(КодДт));
        Запись.Вставить("СчетКт",                Строка(КодКт));
        Запись.Вставить("Контрагент",            Контрагент);
        Запись.Вставить("ИНН",                   ИНН);
        Запись.Вставить("Договор",               Договор);
        Запись.Вставить("ВидДоговора",           ВидДоговора);
        Запись.Вставить("НоменклатурнаяГруппа",  НГ);
        Запись.Вставить("Дата",                  Формат(Выборка.Период, "ДФ=yyyy-MM-dd"));
        Запись.Вставить("ДокументНомер",         Строка(Выборка.РегистраторНомер));
        Запись.Вставить("ДокументДата",          Формат(Выборка.РегистраторДата, "ДФ=yyyy-MM-dd"));
        Запись.Вставить("ДокументРасчетов",      ДокументРасч);
        Запись.Вставить("ДоговорКт",             ?(RecordType = "closed_advance", Строка(Выборка.ДоговорКт), ""));
        Запись.Вставить("Сумма",                 Сумма);
        Запись.Вставить("needs_review",          NeedsReview);

        МассивДанных.Добавить(Запись);
    КонецЦикла;

    // --- 7. JSON -------------------------------------------------------------
    ЗаписьJSON = Новый ЗаписьJSON;
    ЗаписьJSON.УстановитьСтроку();
    ЗаписатьJSON(ЗаписьJSON, МассивДанных);
    JSONСтрока = ЗаписьJSON.Закрыть();

    Возврат СформироватьОтвет(200, JSONСтрока);

КонецФункции

// ----------------------------------------------------------------------------
// Вспомогательные функции (по одной копии на модуль!)
// ----------------------------------------------------------------------------
Функция РазобратьДатуISO(Знач СтрДата)
    // "ГГГГ-ММ-ДД" -> Дата; при любой проблеме возвращает Неопределено
    Попытка
        Части = СтрРазделить(СтрДата, "-");
        Если Части.Количество() <> 3 Тогда
            Возврат Неопределено;
        КонецЕсли;
        Год   = Число(Части[0]);
        Месяц = Число(Части[1]);
        День  = Число(Части[2]);
        Если Год < 2000 ИЛИ Год > 2100 ИЛИ Месяц < 1 ИЛИ Месяц > 12 ИЛИ День < 1 ИЛИ День > 31 Тогда
            Возврат Неопределено;
        КонецЕсли;
        Возврат Дата(Год, Месяц, День);
    Исключение
        Возврат Неопределено;
    КонецПопытки;
КонецФункции

Функция ПодходитПодФильтр(Знач Значение, Знач Фильтр)
    Если НЕ ЗначениеЗаполнено(Фильтр) Тогда
        Возврат Истина;
    КонецЕсли;
    Возврат СтрНайти(ВРег(Значение), ВРег(Фильтр)) > 0;
КонецФункции

// Реквизиты договора через объект (работает и для реквизитов отраслевого
// решения бит_*). Кэш в Соответствии - один читок на уникальный договор.
Функция ПолучитьДанныеДоговора(Знач СсылкаДоговора, КэшДоговоров)

    Найденные = КэшДоговоров.Получить(СсылкаДоговора);
    Если Найденные <> Неопределено Тогда
        Возврат Найденные;
    КонецЕсли;

    Данные = Новый Структура;
    Данные.Вставить("Договор",     Строка(СсылкаДоговора));
    Данные.Вставить("ВидДоговора", "");
    Данные.Вставить("НГ",          "");

    Попытка
        ОбъектДоговора = СсылкаДоговора.ПолучитьОбъект();
        Если ОбъектДоговора <> Неопределено Тогда
            Данные.ВидДоговора = Строка(ОбъектДоговора.ВидДоговора);
            Данные.НГ          = Строка(ОбъектДоговора.бит_стр_Строительство);
        КонецЕсли;
    Исключение
        // реквизит недоступен в этой базе - оставляем пустым, не роняем сервис
    КонецПопытки;

    КэшДоговоров.Вставить(СсылкаДоговора, Данные);
    Возврат Данные;

КонецФункции
