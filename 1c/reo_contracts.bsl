// ============================================================================
// HTTP-сервис: DemoApi (существующий, корневой URL: demo-api)
// Шаблон URL: reo_contracts   Метод: GET   Обработчик: reo_contractsGET
//
// Назначение: программная выгрузка справочника договоров с аналитикой
//   (решение п.8 фазы A: справочник НЕ фиксируется статически - тянется из 1С)
//
// Ответ: [{Договор, ВидДоговора, Контрагент, ИНН, НоменклатурнаяГруппа}]
//
// Параметры (все опциональные, комбинируются, подстрока без регистра):
//   ng          - фильтр по номенклатурной группе ("кто по ней работает")
//   counterparty- фильтр по контрагенту ("его договоры")
//   contract    - фильтр по названию договора
//
// Требует: СформироватьОтвет (уже есть в модуле после osv_60_02)
// ============================================================================

Функция reo_contractsGET(Запрос)

    ФильтрНГ      = Запрос.ПараметрыЗапроса.Получить("ng");
    ФильтрКонтр   = Запрос.ПараметрыЗапроса.Получить("counterparty");
    ФильтрДоговор = Запрос.ПараметрыЗапроса.Получить("contract");
    ФильтрИНН     = Запрос.ПараметрыЗапроса.Получить("inn");

    // В запросе - только стандартные поля: реквизиты расширения (bit_*) язык
    // запросов НЕ видит. НГ и ВидДоговора получаем через точку в коде ниже.
    ТекстЗапроса =
    "ВЫБРАТЬ
    |    Договоры.Ссылка КАК Ссылка,
    |    Договоры.Наименование КАК Договор,
    |    Договоры.Владелец.НаименованиеПолное КАК Контрагент,
    |    Договоры.Владелец.ИНН КАК ИНН
    |ИЗ
    |    Справочник.ДоговорыКонтрагентов КАК Договоры
    |ГДЕ
    |    НЕ Договоры.ПометкаУдаления
    |    И НЕ Договоры.ЭтоГруппа
    |УПОРЯДОЧИТЬ ПО
    |    Договоры.Наименование";

    Попытка
        Запрос1С = Новый Запрос;
        Запрос1С.Текст = ТекстЗапроса;
        Выборка = Запрос1С.Выполнить().Выбрать();
    Исключение
        ОписаниеОшибкиПодробно = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
        Возврат СформироватьОтвет(500, "Ошибка выполнения запроса: " + ОписаниеОшибкиПодробно);
    КонецПопытки;

    МассивДанных = Новый Массив;

    Пока Выборка.Следующий() Цикл

        СсылкаДоговора = Выборка.Ссылка;
        ДоговорНаим    = Строка(Выборка.Договор);
        Контрагент     = Строка(Выборка.Контрагент);
        ИНН            = Строка(Выборка.ИНН);

        // --- Фильтры по стандартным реквизитам (до чтения объекта) ---------
        // ИНН - определяющий признак контрагента: в базе бывают контрагенты
        // с 100% одинаковыми именами, различаются только по ИНН.
        Если НЕ ПодходитПодФильтр(ДоговорНаим, ФильтрДоговор)
            ИЛИ НЕ ПодходитПодФильтр(Контрагент, ФильтрКонтр)
            ИЛИ НЕ ПодходитПодФильтр(ИНН, ФильтрИНН) Тогда
            Продолжить;
        КонецЕсли;

        // Реквизиты через ОБЪЕКТ (реквизит бит_стр_Строительство добавлен
        // отраслевым решением БИТ и недоступен в языке запросов).
        ВидДоговора = "";
        НГ          = "";
        Попытка
            ОбъектДоговора = СсылкаДоговора.ПолучитьОбъект();
            Если ОбъектДоговора <> Неопределено Тогда
                ВидДоговора = Строка(ОбъектДоговора.ВидДоговора);
                НГ          = Строка(ОбъектДоговора.бит_стр_Строительство);
            КонецЕсли;
        Исключение
            // реквизит недоступен в этой базе - оставляем пустым, не роняем сервис
        КонецПопытки;

        // --- Фильтр по НГ (после чтения объекта) ----------------------------
        Если НЕ ПодходитПодФильтр(НГ, ФильтрНГ) Тогда
            Продолжить;
        КонецЕсли;

        Запись = Новый Структура;
        Запись.Вставить("Договор",              ДоговорНаим);
        Запись.Вставить("ВидДоговора",          ВидДоговора);
        Запись.Вставить("Контрагент",           Контрагент);
        Запись.Вставить("ИНН",                  ИНН);
        Запись.Вставить("НоменклатурнаяГруппа", НГ);

        МассивДанных.Добавить(Запись);
    КонецЦикла;

    ЗаписьJSON = Новый ЗаписьJSON;
    ЗаписьJSON.УстановитьСтроку();
    ЗаписатьJSON(ЗаписьJSON, МассивДанных);
    JSONСтрока = ЗаписьJSON.Закрыть();

    Возврат СформироватьОтвет(200, JSONСтрока);

КонецФункции
